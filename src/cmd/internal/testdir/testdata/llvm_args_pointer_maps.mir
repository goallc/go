--- |
  target triple = "aarch64-apple-darwin-goobj"

  %results = type {
    i64, i64, i64, i64, i64, i64, i64, i64,
    i64, i64, i64, i64, i64, i64, i64, i64,
    ptr
  }

  declare goabi0 void @"runtime.morestack_noctxt<ABI0>"()
  declare goabiinternal void @p.safepoint()

  define goabiinternal %results @p.argResult(ptr %input)
      #0 gc "goallc" {
  entry:
    unreachable
  }

  attributes #0 = {
    "frame-pointer"="non-leaf"
    "go_results_tuple"
  }
...
---
name:            p.argResult
alignment:       4
tracksRegLiveness: false
noPhis:          true
isSSA:           false
noVRegs:         true
frameInfo:
  hasStackMap:     true
  stackSize:       0
  maxAlignment:    8
  hasCalls:        true
machineFunctionInfo:
  hasRedZone:      false
  stackSizeZPR:    0
  stackSizePPR:    0
  hasStackFrame:   false
body:             |
  bb.0.entry:
    liveins: $lr

    STACKMAP 5147419139155979380, 0, 1, 8, $sp, 16
    $x3 = COPY $lr
    BL &"runtime.morestack_noctxt<ABI0>", implicit-def $lr, implicit $sp, implicit $x3
    STATEPOINT 1, 0, 0, &p.safepoint, 2, 22, 2, 0, 2, 0, 2, 1, 1, 8, $sp, 8, 2, 0, 2, 1, 0, 0, csr_aarch64_go, implicit-def $sp, implicit-def dead early-clobber $lr
    RET_ReallyLR
...
